{
  "name": "project-management-backend",
  "version": "1.0.0",
  "description": "REST API + Socket.IO backend for Project Management System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "db:reset": "node src/database/migrate.js --fresh && node src/database/seed.js",
    "verify:realtime": "node scripts/verify-realtime.js",
    "verify:api": "node scripts/verify-api.js",
    "verify:collab": "node scripts/verify-collab-search-reminder.js"
  },
  "keywords": [
    "project-management",
    "express",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
